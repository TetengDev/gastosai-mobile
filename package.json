{
  "name": "gastosai-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tetengdev/gastosai-api-contract": "1.0.0",
    "axios": "^1.18.1",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "gen:api": "openapi-typescript node_modules/@tetengdev/gastosai-api-contract/openapi.json -o src/api/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:run": "jest --ci"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/src/**/*.test.ts",
      "**/src/**/*.test.tsx"
    ],
    "globalSetup": "<rootDir>/jest.globalSetup.js"
  }
}
