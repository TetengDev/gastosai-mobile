# Copy to `.env` and set your values. NEVER commit the real .env.
#
# Only EXPO_PUBLIC_* variables are readable from app code, and a shipped binary is fully
# inspectable — so nothing secret belongs here. No AI provider key, no database credential.
# Auth is a backend-issued JWT obtained at runtime and stored in the Keychain/Keystore.

# Base URL of the gastosai backend API.
# Note: localhost does not resolve from a device or Android emulator — use your machine's
# LAN IP (e.g. http://192.168.1.10:8080) or the deployed HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:8080

# GitHub Packages read token for @tetengdev/gastosai-api-contract (read:packages).
# Build-time only — used by npm install, never bundled into the app.
PACKAGE_TOKEN=
