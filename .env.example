# Copy to `.env` and set your values. NEVER commit the real .env.
#
# Only EXPO_PUBLIC_* variables are readable from app code, and a shipped binary is fully
# inspectable — so nothing secret belongs here. No AI provider key, no database credential.
# Auth is a backend-issued JWT obtained at runtime and stored in the Keychain/Keystore.

# Base URL of the gastosai backend API. Used verbatim by a build; in development the LAN
# address below is detected first and wins over this value.
# Note: localhost does not resolve from a device or Android emulator — use the deployed HTTPS
# URL here, and leave the local loop to auto-detection.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Optional. Overrides the base URL in development only — a release bundle ignores it even if
# the build machine had it set. You do not normally need it: `npm start` already detects the
# laptop's LAN address from the Expo dev server, which is the only thing a phone can reach and
# which changes with every network you join. Set it for a non-default port, to pick a specific
# interface when detection guesses wrong, or to point at a tunnel. A loopback host is replaced
# with the detected LAN address, so http://localhost:9090 works as written from a device.
# See docs/local-loop.md.
# EXPO_PUBLIC_API_URL_LOCAL=http://localhost:9090

# GitHub Packages read token for @tetengdev/gastosai-api-contract (read:packages).
# Build-time only — used by npm install, never bundled into the app.
PACKAGE_TOKEN=
